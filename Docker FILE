Docker FILE



 ESTRUTURA DO PROJETO 

voip-agi-project/
├── Dockerfile
├── config/
│   ├── sip.conf
│   ├── extensions.conf
│   ├── queues.conf
│   └── modules.conf
├── agi/
│   └── prioridade.py
└── sounds/

FROM debian:12-slim

LABEL maintainer="Projeto VoIP AGI"
LABEL description="Container Asterisk com suporte a AGI em Python"

# Evita prompts interativos
ENV DEBIAN_FRONTEND=noninteractive

# Atualiza sistema e instala dependências
RUN apt-get update && apt-get install -y \
    asterisk \
    asterisk-dev \
    python3 \
    python3-pip \
    net-tools \
    iputils-ping \
    nano \
    procps \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Cria diretório para scripts AGI
RUN mkdir -p /var/lib/asterisk/agi-bin

# Permissões para AGI
RUN chmod 755 /var/lib/asterisk/agi-bin

# Copia scripts AGI (opcional – pode ser volume)
COPY agi/*.py /var/lib/asterisk/agi-bin/

# Dá permissão de execução
RUN chmod +x /var/lib/asterisk/agi-bin/*.py

# Expõe portas SIP e RTP
EXPOSE 5060/udp
EXPOSE 10000-20000/udp

# Define volumes para configuração
VOLUME ["/etc/asterisk", "/var/lib/asterisk/sounds"]

# Comando principal
CMD ["asterisk", "-f", "-U", "asterisk", "-G", "asterisk"]


BUILD ---

docker build -t asterisk-agi .

Execução do container
docker run -d \
  --name voip-agi \
  -p 5060:5060/udp \
  -p 10000-20000:10000-20000/udp \
  -v ./config:/etc/asterisk \
  -v ./sounds:/var/lib/asterisk/sounds \

  asterisk-agi

