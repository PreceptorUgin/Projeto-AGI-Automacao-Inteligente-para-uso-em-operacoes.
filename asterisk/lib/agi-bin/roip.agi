#!/usr/bin/env python3
import sys
import time
import os

LOG_FILE = "/var/log/asterisk/roip.log"

def agi_read_env():
    env = {}
    while True:
        line = sys.stdin.readline().strip()
        if line == "":
            break

        key, val = line.split(":", 1)
        env[key.strip()] = val.strip()
    return env

def log(event, group, caller, extra=""):
    timestamp = time.strftime("%d-%m-%Y %H:%M:%S")
    line = f"{timestamp} | {event} | group={group} | caller={caller} | {extra}\n"
    with open(LOG_FILE, "a") as f:
        f.write(line)

env = agi_read_env()
# Argumentos do dialplan
event = sys.argv[1] if len(sys.argv) > 1 else "unknown"
group = sys.argv[2] if len(sys.argv) > 2 else "undef"
caller = sys.argv[3] if len(sys.argv) > 3 else "undef"

now = int(time.time())

# Arquivos de estado simples por chamada
STATE_DIR = "/tmp/roip"
os.makedirs(STATE_DIR, exist_ok=True)

talk_file = f"{STATE_DIR}/talk_{group}_{caller}"
queue_file = f"{STATE_DIR}/queue_{group}_{caller}"

if event == "request":
    log("REQUEST", group, caller)

elif event == "grant":
     with open(talk_file, "w") as f:
        f.write(str(now))
    log("GRANT", group, caller)

elif event == "release":
    if os.path.exists(talk_file):
        with open(talk_file) as f:
            start = int(f.read())
        duration = now - start
        os.remove(talk_file)
        log("RELEASE", group, caller, f"talk_time={duration}s")
    else:
        log("RELEASE", group, caller, "talk_time=unkown")

elif event == "enqueue":
    with open(queue_file), "w") as f:
        f.write(str(now))
    log("ENQUEUE", group, caller)

elif event == "dequeue":
    if os.path.exists(queue_file):
        with open(queue_file) as f:
            start = int(f.read())
        wait = now - start
        os.remove(queue_file)
        log("DEQUEUE", group, caller, f"wait_time={wait}s")
    else:
        log("DEQUEUE", group, caller, "wait_time=unknown")

elif event == "hangup":
    log("HANGUP", group, caller, "forced_release")

elif event == "abandon":
    if os.path.exists(queue_file):
        with open(queue_file) as f:
            start = int(f.read())
        wait = now - start
        os.remove(queue_file)
        log("ABANDON", group, caller, f"wait_time={wait}s")
    else:
        log("ABANDON", group, caller)

elif event == "deny":
    log("DENY", group, caller)

else:
    log("UNKNOWN", group, caller, f"event{event}")
